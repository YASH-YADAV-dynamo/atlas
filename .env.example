# Copy to .env and fill in. Never commit .env.
HYDRADB_URL=bolt://127.0.0.1:7687
HYDRADB_TOKEN=replace-with-your-hydradb-token
HYDRADB_GRAPH=default
ATLAS_STORE=hydradb
ATLAS_API_KEY=replace-with-a-long-random-string
ATLAS_NAMESPACE=demo
ATLAS_API_URL=http://127.0.0.1:8000
ANTHROPIC_API_KEY=replace-with-your-anthropic-key
# OpenAI-compatible provider (e.g. DeepSeek): MODEL_PROVIDER=openai, MODEL_BASE_URL, MODEL_API_KEY
# (DEEPSEEK_API_KEY is accepted as an alias of MODEL_API_KEY); ATLAS_MODEL_ID=deepseek-chat
MODEL_BASE_URL=https://api.deepseek.com
MODEL_API_KEY=replace-with-your-deepseek-key
MODEL_PROVIDER=anthropic
MODEL_PRICE_IN_PER_M=0.30
MODEL_PRICE_OUT_PER_M=1.20
MODEL_LEDGER_PATH=data/model_ledger.json
MODEL_BUDGET_USD=1.50
DEMO_MODEL_RUNS_PER_IP_HOUR=3
DEMO_MAX_EXPLORE_STEPS=8
ATLAS_MODEL_ID=claude-sonnet-5-5
TESTMART_URL=http://127.0.0.1:8100
TESTMART_USER=admin
TESTMART_PASSWORD=replace-with-testmart-password
DEMO_MAX_CONCURRENT_RUNS=2
DEMO_MAX_QUEUED_RUNS=8
MCP_MODE=runner
MCP_SITE=testmart
TESTMART_SECRET=replace-with-a-long-random-string
ATLAS_KEY_PEPPER=replace-with-a-long-random-string
ATLAS_DEMO_MCP_KEY=replace-with-a-long-random-string
